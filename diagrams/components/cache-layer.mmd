%% Cache Layer Architecture
%% Shows cache hit/miss flow between application, cache, and database

flowchart LR
    subgraph Application
        APP[Application Server]
    end

    subgraph CacheLayer["Cache Layer"]
        CACHE[(Redis/Memcached<br/>In-Memory Cache)]
    end

    subgraph Database
        DB[(Primary Database<br/>PostgreSQL/MySQL)]
    end

    APP -->|1. Check Cache| CACHE
    
    CACHE -->|2a. Cache HIT| APP
    
    CACHE -.->|2b. Cache MISS| DB
    DB -.->|3. Fetch Data| CACHE
    CACHE -.->|4. Update Cache<br/>+ Return| APP

    %% Legend
    subgraph Legend
        L1[Solid: Primary Path]
        L2[Dashed: Miss Path]
    end

    %% Styling
    style CACHE fill:#f6ad55,stroke:#c05621,color:#000
    style DB fill:#4a5568,stroke:#1a202c,color:#fff
    style APP fill:#4299e1,stroke:#2b6cb0,color:#fff
    style L1 fill:#48bb78,stroke:#276749,color:#fff
    style L2 fill:#fc8181,stroke:#c53030,color:#fff
