%% Message Queue Architecture
%% Shows producer-consumer pattern with message queue

flowchart LR
    subgraph Producers["Producers"]
        P1[Order Service]
        P2[Payment Service]
        P3[Notification Service]
    end

    subgraph MessageQueue["Message Queue (Kafka/RabbitMQ)"]
        Q[Message Queue<br/>Durable Storage<br/>FIFO Processing]
        DLQ[Dead Letter Queue<br/>Failed Messages]
    end

    subgraph Consumers["Consumers"]
        C1[Email Worker]
        C2[SMS Worker]
        C3[Analytics Worker]
    end

    P1 -->|Publish| Q
    P2 -->|Publish| Q
    P3 -->|Publish| Q

    Q -->|Subscribe| C1
    Q -->|Subscribe| C2
    Q -->|Subscribe| C3

    Q -.->|Failed| DLQ
    DLQ -.->|Retry/Manual| Q

    %% Styling
    style Q fill:#f6ad55,stroke:#c05621,color:#000
    style DLQ fill:#fc8181,stroke:#c53030,color:#fff
    style P1 fill:#4299e1,stroke:#2b6cb0,color:#fff
    style P2 fill:#4299e1,stroke:#2b6cb0,color:#fff
    style P3 fill:#4299e1,stroke:#2b6cb0,color:#fff
    style C1 fill:#48bb78,stroke:#276749,color:#fff
    style C2 fill:#48bb78,stroke:#276749,color:#fff
    style C3 fill:#48bb78,stroke:#276749,color:#fff
