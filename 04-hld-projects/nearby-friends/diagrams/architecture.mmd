    classDef queue fill:#fff4e6,stroke:#ffc078,stroke-width:2px;
    classDef compute fill:#e6f3ff,stroke:#74c0fc,stroke-width:2px;

    class RedisCache,Cassandra,FriendGraph db;
    class KafkaQueue,RedisPubSub queue;
    class WS1,WS2,WS3,Workers compute;
