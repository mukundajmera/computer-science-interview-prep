erDiagram
    VENUE ||--o{ EVENT : hosts
    VENUE ||--o{ SECTION : contains
    SECTION ||--o{ SEAT : contains

    EVENT ||--o{ SEAT : "has inventory for"
    EVENT ||--o{ RESERVATION : has
    EVENT ||--o{ ORDER : has

    SEAT ||--o{ RESERVATION : "is held in"
    SEAT ||--o{ TICKET : "is booked for"

    USER ||--o{ RESERVATION : makes
    USER ||--o{ ORDER : places

    RESERVATION ||--o| ORDER : "converted to"

    ORDER ||--o{ PAYMENT : has
    ORDER ||--o{ TICKET : includes

    VENUE {
        string venue_id PK
        string name
        string location
        int capacity
    }

    EVENT {
        string event_id PK
        string venue_id FK
        string name
        datetime start_at
        string status
        json pricing_policy
    }

    SECTION {
        string section_id PK
        string venue_id FK
        string name
    }

    SEAT {
        string seat_id PK
        string event_id FK
        string section_id FK
        string row
        string number
        string seat_state
        int version
    }

    USER {
        string user_id PK
        string email
        string name
    }

    RESERVATION {
        string hold_id PK
        string event_id FK
        string user_id FK
        json seat_ids
        datetime expires_at
        string status
    }

    ORDER {
        string booking_id PK
        string hold_id FK
        string user_id FK
        string event_id FK
        string booking_state
        decimal amount
        datetime created_at
    }

    PAYMENT {
        string payment_id PK
        string booking_id FK
        string provider
        string status
        decimal amount
        string reference_id
    }

    TICKET {
        string ticket_id PK
        string booking_id FK
        string seat_id FK
        string barcode
        datetime issued_at
        string status
    }
