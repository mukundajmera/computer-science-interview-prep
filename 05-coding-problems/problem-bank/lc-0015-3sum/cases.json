{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "three distinct triplets",
      "input": {
        "nums": [
          -2,
          -1,
          0,
          1,
          2,
          3
        ]
      },
      "expected": [
        [
          -2,
          -1,
          3
        ],
        [
          -2,
          0,
          2
        ],
        [
          -1,
          0,
          1
        ]
      ]
    },
    {
      "name": "all zeros",
      "input": {
        "nums": [
          0,
          0,
          0,
          0
        ]
      },
      "expected": [
        [
          0,
          0,
          0
        ]
      ]
    },
    {
      "name": "no match",
      "input": {
        "nums": [
          1,
          2,
          -2,
          -1
        ]
      },
      "expected": []
    },
    {
      "name": "duplicate pairs",
      "input": {
        "nums": [
          -4,
          -2,
          -2,
          0,
          2,
          2,
          4
        ]
      },
      "expected": [
        [
          -4,
          0,
          4
        ],
        [
          -4,
          2,
          2
        ],
        [
          -2,
          -2,
          4
        ],
        [
          -2,
          0,
          2
        ]
      ]
    }
  ]
}
