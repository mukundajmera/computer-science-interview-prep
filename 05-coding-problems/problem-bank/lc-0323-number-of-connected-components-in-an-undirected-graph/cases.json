    {
      "name": "all isolated",
      "input": {
        "n": 4,
        "edges": []
      },
      "expected": 4
    },
    {
      "name": "one connected component",
      "input": {
        "n": 5,
        "edges": [
          [
            0,
            1
          ],
          [
            1,
            2
          ],
          [
            2,
            3
          ],
          [
            3,
            4
          ]
        ]
      },
      "expected": 1
    },
    {
      "name": "cycle still one component",
      "input": {
        "n": 3,
        "edges": [
          [
            0,
            1
          ],
          [
            1,
            2
          ],
          [
            2,
            0
          ]
        ]
      },
      "expected": 1
    },
    {
      "name": "mixed isolated and connected",
      "input": {
        "n": 6,
        "edges": [
          [
            0,
            1
          ],
          [
            2,
            3
          ],
          [
            3,
            4
          ]
        ]
      },
      "expected": 3
