          [
            1,
            3
          ]
        ]
      },
      "expected": "abc"
    },
    {
      "name": "net right",
      "input": {
        "s": "hello",
        "shift": [
          [
            1,
            2
          ]
        ]
      },
      "expected": "lohel"
    }
  ]
}
