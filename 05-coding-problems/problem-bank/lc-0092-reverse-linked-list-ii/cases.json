{
  "source": "repo-authored-clean-room",
  "matcher": { "type": "exact" },
  "cases": [
    {
      "name": "reverse interior segment",
      "input": { "head": [7, 2, 5, 8, 1], "left": 2, "right": 4 },
      "expected": [7, 8, 5, 2, 1],
      "linkedListContract": {
        "result": { "from": "head", "nodeIndices": [0, 3, 2, 1, 4] }
      }
    },
    {
      "name": "reverse from head",
      "input": { "head": [3, 6, 9], "left": 1, "right": 2 },
      "expected": [6, 3, 9],
      "linkedListContract": {
        "result": { "from": "head", "nodeIndices": [1, 0, 2] }
      }
    },
    {
      "name": "single position unchanged",
      "input": { "head": [4, 5], "left": 2, "right": 2 },
      "expected": [4, 5],
      "linkedListContract": {
        "result": { "from": "head", "nodeIndices": [0, 1] }
      }
    }
  ]
}
