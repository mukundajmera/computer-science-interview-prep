{
  "source": "repo-authored-clean-room",
  "matcher": { "type": "exact" },
  "cases": [
    {
      "name": "interleave uneven chains",
      "input": { "list1": [0, 3, 8], "list2": [1, 4, 7] },
      "expected": [0, 1, 3, 4, 7, 8]
    },
    {
      "name": "left chain empty",
      "input": { "list1": null, "list2": [-2, 5] },
      "expected": [-2, 5]
    },
    {
      "name": "right chain empty",
      "input": { "list1": [2], "list2": null },
      "expected": [2]
    }
  ]
}
