{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "unordered-list-of-lists"
  },
  "cases": [
    {
      "name": "duplicate twos",
      "input": {
        "candidates": [
          2,
          5,
          2,
          1,
          2
        ],
        "target": 5
      },
      "expected": [
        [
          1,
          2,
          2
        ],
        [
          5
        ]
      ]
    },
    {
      "name": "three ways with repeated ones",
      "input": {
        "candidates": [
          3,
          1,
          3,
          5,
          1,
          1
        ],
        "target": 6
      },
      "expected": [
        [
          1,
          1,
          1,
          3
        ],
        [
          1,
          5
        ],
        [
          3,
          3
        ]
      ]
    },
    {
      "name": "single duplicate pair",
      "input": {
        "candidates": [
          4,
          4,
          4
        ],
        "target": 8
      },
      "expected": [
        [
          4,
          4
        ]
      ]
    }
  ]
}
