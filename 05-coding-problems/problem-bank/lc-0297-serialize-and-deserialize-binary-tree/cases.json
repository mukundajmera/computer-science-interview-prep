{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "empty tree",
      "operations": [
        {
          "type": "constructor",
          "input": {},
          "expected": null
        },
        {
          "type": "call",
          "method": "serialize",
          "input": {
            "root": null
          },
          "expected": "#"
        },
        {
          "type": "call",
          "method": "deserialize",
          "input": {
            "data": "#"
          },
          "expected": []
        }
      ]
    },
    {
      "name": "asymmetric tree",
      "operations": [
        {
          "type": "constructor",
          "input": {},
          "expected": null
        },
        {
          "type": "call",
          "method": "serialize",
          "input": {
            "root": [
              1,
              2,
              3,
              null,
              4,
              -5,
              6
            ]
          },
          "expected": "1,2,#,4,#,#,3,-5,#,#,6,#,#"
        },
        {
          "type": "call",
          "method": "deserialize",
          "input": {
            "data": "1,2,#,4,#,#,3,-5,#,#,6,#,#"
          },
          "expected": [
            1,
            2,
            3,
            null,
            4,
            -5,
            6
          ]
        }
      ]
    }
  ]
}
