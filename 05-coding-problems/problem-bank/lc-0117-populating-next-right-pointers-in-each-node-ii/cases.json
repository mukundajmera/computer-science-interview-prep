{
  "source": "repo-authored-clean-room",
  "matcher": { "type": "exact" },
  "cases": [
    {
      "name": "ragged levels with internal gaps",
      "input": { "root": [10, 5, 20, 3, null, 15, 30, null, 4] },
      "expected": [[10], [5, 20], [3, 15, 30], [4]],
      "expectedMutations": {
        "root": [[10], [5, 20], [3, 15, 30], [4]]
      }
    },
    {
      "name": "single node",
      "input": { "root": [7] },
      "expected": [[7]],
      "expectedMutations": {
        "root": [[7]]
      }
    },
    {
      "name": "empty tree",
      "input": { "root": [] },
      "expected": [],
      "expectedMutations": {
        "root": []
      }
    }
  ]
}
