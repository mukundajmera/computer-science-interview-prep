{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "mixed signs and rises",
      "input": {
        "nums": [
          4,
          2,
          12,
          3,
          -1,
          6,
          8
        ],
        "k": 3
      },
      "expected": [
        12,
        12,
        12,
        6,
        8
      ]
    },
    {
      "name": "single element window",
      "input": {
        "nums": [
          1,
          -1,
          3
        ],
        "k": 1
      },
      "expected": [
        1,
        -1,
        3
      ]
    },
    {
      "name": "strictly decreasing",
      "input": {
        "nums": [
          9,
          8,
          7,
          6
        ],
        "k": 2
      },
      "expected": [
        9,
        8,
        7
      ]
    },
    {
      "name": "whole array window",
      "input": {
        "nums": [
          2,
          1,
          5
        ],
        "k": 3
      },
      "expected": [
        5
      ]
    },
    {
      "name": "duplicates in queue",
      "input": {
        "nums": [
          4,
          3,
          5,
          4,
          3,
          3,
          6,
          7
        ],
        "k": 3
      },
      "expected": [
        5,
        5,
        5,
        4,
        6,
        7
      ]
    },
    {
      "name": "stale max leaves window",
      "input": {
        "nums": [
          7,
          2,
          4
        ],
        "k": 2
      },
      "expected": [
        7,
        4
      ]
    },
    {
      "name": "duplicate max values",
      "input": {
        "nums": [
          2,
          2,
          2,
          2
        ],
        "k": 3
      },
      "expected": [
        2,
        2
      ]
    }
  ]
}
