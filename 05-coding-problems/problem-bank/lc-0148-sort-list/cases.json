{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "mixed values",
      "input": {
        "head": [
          8,
          3,
          5,
          1
        ]
      },
      "expected": [
        1,
        3,
        5,
        8
      ]
    },
    {
      "name": "duplicates stay sorted",
      "input": {
        "head": [
          4,
          2,
          4,
          1
        ]
      },
      "expected": [
        1,
        2,
        4,
        4
      ]
    },
    {
      "name": "empty list",
      "input": {
        "head": null
      },
      "expected": null
    }
  ]
}
