      "linkedListContract": {
        "postCall": {
          "head": [
            0,
            3,
            1,
            2
          ]
        }
      }
    },
    {
      "name": "odd length",
      "input": {
        "head": [
          5,
          1,
          8,
          3,
          6
        ]
      },
      "expected": null,
      "expectedMutations": {
        "head": [
          5,
          6,
          1,
          3,
          8
        ]
      },
      "linkedListContract": {
        "postCall": {
          "head": [
            0,
            4,
            1,
            3,
            2
          ]
        }
      }
    },
    {
      "name": "single node",
      "input": {
        "head": [
          7
        ]
      },
      "expected": null,
      "expectedMutations": {
        "head": [
          7
        ]
      },
      "linkedListContract": {
        "postCall": {
          "head": [
            0
          ]
        }
      }
    },
    {
      "name": "two nodes unchanged",
      "input": {
        "head": [
          1,
          2
        ]
      },
      "expected": null,
      "expectedMutations": {
        "head": [
          1,
          2
        ]
      },
      "linkedListContract": {
        "postCall": {
          "head": [
            0,
            1
          ]
        }
      }
    }
  ]
