{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "duplicate in middle",
      "input": {
        "nums": [
          1,
          3,
          4,
          2,
          2
        ]
      },
      "expected": 2
    },
    {
      "name": "duplicate at start value",
      "input": {
        "nums": [
          3,
          1,
          3,
          4,
          2
        ]
      },
      "expected": 3
    },
    {
      "name": "two item array",
      "input": {
        "nums": [
          1,
          1
        ]
      },
      "expected": 1
    },
    {
      "name": "same duplicate repeated many times",
      "input": {
        "nums": [
          2,
          2,
          2,
          2,
          2
        ]
      },
      "expected": 2
    },
    {
      "name": "duplicate is largest value",
      "input": {
        "nums": [
          1,
          4,
          6,
          3,
          2,
          5,
          6
        ]
      },
      "expected": 6
    },
    {
      "name": "duplicate appears three times",
      "input": {
        "nums": [
          1,
          4,
          4,
          2,
          4,
          3
        ]
      },
      "expected": 4
    },
    {
      "name": "small duplicate appears many times",
      "input": {
        "nums": [
          1,
          5,
          1,
          2,
          3,
          4,
          1
        ]
      },
      "expected": 1
    }
  ]
}
