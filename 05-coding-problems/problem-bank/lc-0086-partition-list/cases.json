{
  "source": "repo-authored-clean-room",
  "matcher": { "type": "exact" },
  "cases": [
    {
      "name": "mixed values stable partition",
      "input": { "head": [5, 1, 4, 2, 6, 3], "x": 4 },
      "expected": [1, 2, 3, 5, 4, 6],
      "linkedListContract": {
        "result": { "from": "head", "nodeIndices": [1, 3, 5, 0, 2, 4] }
      }
    },
    {
      "name": "duplicate values preserve stable partitions",
      "input": { "head": [3, 1, 3, 2, 1], "x": 3 },
      "expected": [1, 2, 1, 3, 3],
      "linkedListContract": {
        "result": { "from": "head", "nodeIndices": [1, 3, 4, 0, 2] }
      }
    },
    {
      "name": "all values stay in right partition",
      "input": { "head": [7, 5, 6], "x": 4 },
      "expected": [7, 5, 6],
      "linkedListContract": {
        "result": { "from": "head", "nodeIndices": [0, 1, 2] }
      }
    },
    {
      "name": "empty chain",
      "input": { "head": null, "x": 10 },
      "expected": null
    }
  ]
}
