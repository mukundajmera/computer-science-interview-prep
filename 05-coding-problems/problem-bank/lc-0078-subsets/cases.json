{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "unordered-list-of-lists"
  },
  "cases": [
    {
      "name": "three values",
      "input": {
        "nums": [
          1,
          2,
          3
        ]
      },
      "expected": [
        [],
        [
          1
        ],
        [
          2
        ],
        [
          3
        ],
        [
          1,
          2
        ],
        [
          1,
          3
        ],
        [
          2,
          3
        ],
        [
          1,
          2,
          3
        ]
      ]
    },
    {
      "name": "single value",
      "input": {
        "nums": [
          5
        ]
      },
      "expected": [
        [],
        [
          5
        ]
      ]
    },
    {
      "name": "empty input",
      "input": {
        "nums": []
      },
      "expected": [
        []
      ]
    },
    {
      "name": "negative and zero",
      "input": {
        "nums": [
          -1,
          0
        ]
      },
      "expected": [
        [],
        [
          -1
        ],
        [
          0
        ],
        [
          -1,
          0
        ]
      ]
    }
  ]
}
