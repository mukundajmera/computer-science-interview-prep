{
  "source": "repo-authored-clean-room",
  "matcher": { "type": "float-tolerance", "tolerance": 0.000000001 },
  "cases": [
    {
      "name": "odd total interleaved",
      "input": { "nums1": [1, 4, 9], "nums2": [2, 6] },
      "expected": 4.0
    },
    {
      "name": "even total crossing arrays",
      "input": { "nums1": [2, 8], "nums2": [1, 7] },
      "expected": 4.5
    },
    {
      "name": "first array empty",
      "input": { "nums1": [], "nums2": [7] },
      "expected": 7.0
    },
    {
      "name": "duplicates across arrays",
      "input": { "nums1": [-5, -1, 3], "nums2": [-1, -1, 10, 12] },
      "expected": -1.0
    }
  ]
}
