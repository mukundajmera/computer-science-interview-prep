{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "duplicates around uniques",
      "input": {
        "head": [
          1,
          1,
          2,
          3,
          3,
          4,
          5,
          5
        ]
      },
      "expected": [
        2,
        4
      ],
      "linkedListContract": {
        "result": {
          "from": "head",
          "nodeIndices": [
            2,
            5
          ]
        }
      }
    },
    {
      "name": "all unique values",
      "input": {
        "head": [
          1,
          2,
          3,
          4
        ]
      },
      "expected": [
        1,
        2,
        3,
        4
      ],
      "linkedListContract": {
        "result": {
          "from": "head",
          "nodeIndices": [
            0,
            1,
            2,
            3
          ]
        }
      }
    },
    {
      "name": "all values duplicated",
      "input": {
        "head": [
          7,
          7,
          7
        ]
      },
      "expected": null,
      "linkedListContract": {
        "result": {
          "from": "head",
          "nodeIndices": []
        }
      }
    }
  ]
}
