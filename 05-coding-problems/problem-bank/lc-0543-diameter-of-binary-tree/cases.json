{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "balanced tree through root",
      "input": {
        "root": [
          1,
          2,
          3,
          4,
          5
        ]
      },
      "expected": 3
    },
    {
      "name": "single node",
      "input": {
        "root": [
          1
        ]
      },
      "expected": 0
    },
    {
      "name": "skewed tree",
      "input": {
        "root": [
          1,
          2,
          null,
          3,
          null,
          4
        ]
      },
      "expected": 3
    },
    {
      "name": "diameter below root",
      "input": {
        "root": [
          5,
          2,
          9,
          1,
          3,
          null,
          null,
          0,
          null,
          null,
          4
        ]
      },
      "expected": 4
    }
  ]
}
