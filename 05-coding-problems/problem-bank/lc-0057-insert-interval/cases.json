{
  "source": "repo-authored-clean-room",
  "matcher": { "type": "exact" },
  "cases": [
    { "name": "insert into gap", "input": { "intervals": [[2, 4], [7, 9]], "newInterval": [5, 6] }, "expected": [[2, 4], [5, 6], [7, 9]] },
    { "name": "overlap multiple intervals", "input": { "intervals": [[2, 4], [8, 10]], "newInterval": [3, 9] }, "expected": [[2, 10]] },
    { "name": "insert before all", "input": { "intervals": [[5, 7], [9, 12]], "newInterval": [1, 3] }, "expected": [[1, 3], [5, 7], [9, 12]] },
    { "name": "insert after all", "input": { "intervals": [[1, 2], [4, 5]], "newInterval": [8, 10] }, "expected": [[1, 2], [4, 5], [8, 10]] },
    { "name": "empty original", "input": { "intervals": [], "newInterval": [4, 8] }, "expected": [[4, 8]] }
  ]
}
