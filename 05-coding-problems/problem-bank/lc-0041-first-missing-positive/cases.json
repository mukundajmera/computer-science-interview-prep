{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "zero fills first gap",
      "input": {
        "nums": [
          1,
          2,
          0
        ]
      },
      "expected": 3
    },
    {
      "name": "negative and large noise",
      "input": {
        "nums": [
          3,
          4,
          -1,
          1
        ]
      },
      "expected": 2
    },
    {
      "name": "all above range",
      "input": {
        "nums": [
          7,
          8,
          9,
          11,
          12
        ]
      },
      "expected": 1
    },
    {
      "name": "single one",
      "input": {
        "nums": [
          1
        ]
      },
      "expected": 2
    },
    {
      "name": "single two missing one",
      "input": {
        "nums": [
          2
        ]
      },
      "expected": 1
    },
    {
      "name": "one two order reversed",
      "input": {
        "nums": [
          2,
          1
        ]
      },
      "expected": 3
    },
    {
      "name": "duplicate one",
      "input": {
        "nums": [
          1,
          1
        ]
      },
      "expected": 2
    },
    {
      "name": "duplicate blocks middle gap",
      "input": {
        "nums": [
          4,
          1,
          2,
          2
        ]
      },
      "expected": 3
    },
    {
      "name": "full prefix out of order",
      "input": {
        "nums": [
          2,
          1,
          3,
          5,
          4
        ]
      },
      "expected": 6
    },
    {
      "name": "large noise with prefix",
      "input": {
        "nums": [
          100000,
          1,
          -1,
          2
        ]
      },
      "expected": 3
    }
  ]
}
