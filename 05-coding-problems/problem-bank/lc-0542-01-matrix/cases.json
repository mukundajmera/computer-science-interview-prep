{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "single center one",
      "input": {
        "mat": [
          [
            0,
            0,
            0
          ],
          [
            0,
            1,
            0
          ],
          [
            0,
            0,
            0
          ]
        ]
      },
      "expected": [
        [
          0,
          0,
          0
        ],
        [
          0,
          1,
          0
        ],
        [
          0,
          0,
          0
        ]
      ]
    },
    {
      "name": "distances grow from corner zeroes",
      "input": {
        "mat": [
          [
            0,
            1,
            1
          ],
          [
            1,
            1,
            1
          ],
          [
            1,
            1,
            0
          ]
        ]
      },
      "expected": [
        [
          0,
          1,
          2
        ],
        [
          1,
          2,
          1
        ],
        [
          2,
          1,
          0
        ]
      ]
    },
    {
      "name": "one row matrix",
      "input": {
        "mat": [
          [
            1,
            1,
            0,
            1
          ]
        ]
      },
      "expected": [
        [
          2,
          1,
          0,
          1
        ]
      ]
    },
    {
      "name": "one column matrix",
      "input": {
        "mat": [
          [
            1
          ],
          [
            0
          ],
          [
            1
          ],
          [
            1
          ]
        ]
      },
      "expected": [
        [
          1
        ],
        [
          0
        ],
        [
          1
        ],
        [
          2
        ]
      ]
    },
    {
      "name": "all zeroes stay zero",
      "input": {
        "mat": [
          [
            0,
            0
          ],
          [
            0,
            0
          ]
        ]
      },
      "expected": [
        [
          0,
          0
        ],
        [
          0,
          0
        ]
      ]
    }
  ]
}
