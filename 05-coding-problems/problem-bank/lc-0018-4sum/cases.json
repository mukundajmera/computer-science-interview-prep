{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "unordered-list-of-lists"
  },
  "cases": [
    {
      "name": "three different quadruplets",
      "input": {
        "nums": [
          2,
          -1,
          0,
          1,
          -2,
          3
        ],
        "target": 2
      },
      "expected": [
        [
          -2,
          -1,
          2,
          3
        ],
        [
          -2,
          0,
          1,
          3
        ],
        [
          -1,
          0,
          1,
          2
        ]
      ]
    },
    {
      "name": "all zeros collapse to one row",
      "input": {
        "nums": [
          0,
          0,
          0,
          0,
          0
        ],
        "target": 0
      },
      "expected": [
        [
          0,
          0,
          0,
          0
        ]
      ]
    },
    {
      "name": "no match",
      "input": {
        "nums": [
          5,
          5,
          5,
          5
        ],
        "target": 1
      },
      "expected": []
    }
  ]
}
