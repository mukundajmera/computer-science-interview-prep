{
  "source": "repo-authored-clean-room",
  "matcher": { "type": "exact" },
  "cases": [
    {
      "name": "remove repeated edge value",
      "input": { "nums": [4, 1, 4, 2, 5], "val": 4 },
      "expected": 3,
      "expectedMutations": { "nums": { "prefix": [1, 2, 5], "lengthFrom": "return" } }
    },
    {
      "name": "no values removed",
      "input": { "nums": [6, 7, 8], "val": 5 },
      "expected": 3,
      "expectedMutations": { "nums": { "prefix": [6, 7, 8], "lengthFrom": "return" } }
    },
    {
      "name": "all values removed",
      "input": { "nums": [9, 9, 9], "val": 9 },
      "expected": 0,
      "expectedMutations": { "nums": { "prefix": [], "lengthFrom": "return" } }
    },
    {
      "name": "remove alternating values",
      "input": { "nums": [2, 3, 2, 4, 2, 5], "val": 2 },
      "expected": 3,
      "expectedMutations": { "nums": { "prefix": [3, 4, 5], "lengthFrom": "return" } }
    }
  ]
}
