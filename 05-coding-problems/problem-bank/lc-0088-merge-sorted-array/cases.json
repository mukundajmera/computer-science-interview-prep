{
  "source": "repo-authored-clean-room",
  "matcher": { "type": "exact" },
  "cases": [
    {
      "name": "interleaved positives",
      "input": { "nums1": [2, 5, 9, 0, 0, 0], "m": 3, "nums2": [1, 6, 10], "n": 3 },
      "expected": null,
      "expectedMutations": { "nums1": [1, 2, 5, 6, 9, 10] }
    },
    {
      "name": "negative from second array leads",
      "input": { "nums1": [-4, 3, 0, 0], "m": 2, "nums2": [-5, 7], "n": 2 },
      "expected": null,
      "expectedMutations": { "nums1": [-5, -4, 3, 7] }
    },
    {
      "name": "second array fills most buffer",
      "input": { "nums1": [4, 0, 0, 0], "m": 1, "nums2": [1, 2, 3], "n": 3 },
      "expected": null,
      "expectedMutations": { "nums1": [1, 2, 3, 4] }
    },
    {
      "name": "empty second array",
      "input": { "nums1": [1, 3, 5], "m": 3, "nums2": [], "n": 0 },
      "expected": null,
      "expectedMutations": { "nums1": [1, 3, 5] }
    }
  ]
}
