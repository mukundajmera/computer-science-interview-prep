{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "four unsorted elements",
      "input": {
        "head": [
          4,
          2,
          1,
          3
        ]
      },
      "expected": [
        1,
        2,
        3,
        4
      ]
    },
    {
      "name": "mixed positive and negative",
      "input": {
        "head": [
          -1,
          5,
          3,
          4,
          0
        ]
      },
      "expected": [
        -1,
        0,
        3,
        4,
        5
      ]
    },
    {
      "name": "empty list",
      "input": {
        "head": null
      },
      "expected": null
    }
  ]
}
