{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "multiple downward paths",
      "input": {
        "root": [
          10,
          5,
          -3,
          3,
          2,
          null,
          11,
          3,
          -2,
          null,
          1
        ],
        "targetSum": 8
      },
      "expected": 3
    },
    {
      "name": "negative values",
      "input": {
        "root": [
          1,
          -2,
          -3,
          1,
          3,
          -2,
          null,
          -1
        ],
        "targetSum": -1
      },
      "expected": 4
    },
    {
      "name": "single matching node",
      "input": {
        "root": [
          5
        ],
        "targetSum": 5
      },
      "expected": 1
    },
    {
      "name": "empty tree",
      "input": {
        "root": [],
        "targetSum": 0
      },
      "expected": 0
    },
    {
      "name": "prefix counts backtrack across siblings",
      "input": {
        "root": [
          0,
          1,
          1
        ],
        "targetSum": 0
      },
      "expected": 1
    }
  ]
}
