{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "simple valid tree",
      "input": {
        "n": 5,
        "edges": [
          [
            0,
            1
          ],
          [
            0,
            2
          ],
          [
            0,
            3
          ],
          [
            1,
            4
          ]
        ]
      },
      "expected": true
    },
    {
      "name": "cycle invalid",
      "input": {
        "n": 5,
        "edges": [
          [
            0,
            1
          ],
          [
            1,
            2
          ],
          [
            2,
            3
          ],
          [
            1,
            3
          ],
          [
            1,
            4
          ]
        ]
      },
      "expected": false
    },
    {
      "name": "disconnected invalid",
      "input": {
        "n": 4,
        "edges": [
          [
            0,
            1
          ],
          [
            2,
            3
          ]
        ]
      },
      "expected": false
    },
    {
      "name": "single node",
      "input": {
        "n": 1,
        "edges": []
      },
      "expected": true
    },
    {
      "name": "too many edges",
      "input": {
        "n": 3,
        "edges": [
          [
            0,
            1
          ],
          [
            1,
            2
          ],
          [
            0,
            2
          ]
        ]
      },
      "expected": false
    }
  ]
}
