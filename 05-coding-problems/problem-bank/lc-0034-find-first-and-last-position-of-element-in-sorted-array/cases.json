{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "middle run of duplicates",
      "input": {
        "nums": [
          2,
          4,
          4,
          4,
          9,
          12
        ],
        "target": 4
      },
      "expected": [
        1,
        3
      ]
    },
    {
      "name": "missing target",
      "input": {
        "nums": [
          2,
          4,
          4,
          4,
          9,
          12
        ],
        "target": 5
      },
      "expected": [
        -1,
        -1
      ]
    },
    {
      "name": "prefix run",
      "input": {
        "nums": [
          1,
          1,
          1,
          2,
          3
        ],
        "target": 1
      },
      "expected": [
        0,
        2
      ]
    },
    {
      "name": "empty array",
      "input": {
        "nums": [],
        "target": 4
      },
      "expected": [
        -1,
        -1
      ]
    },
    {
      "name": "suffix run",
      "input": {
        "nums": [
          1,
          3,
          5,
          8,
          8,
          8
        ],
        "target": 8
      },
      "expected": [
        3,
        5
      ]
    },
    {
      "name": "all elements equal target",
      "input": {
        "nums": [
          6,
          6,
          6,
          6
        ],
        "target": 6
      },
      "expected": [
        0,
        3
      ]
    }
  ]
}
