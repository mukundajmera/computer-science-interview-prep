{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "basic fifo order",
      "operations": [
        {
          "type": "constructor",
          "input": {},
          "expected": null
        },
        {
          "type": "call",
          "method": "push",
          "input": {
            "x": 1
          },
          "expected": null
        },
        {
          "type": "call",
          "method": "push",
          "input": {
            "x": 2
          },
          "expected": null
        },
        {
          "type": "call",
          "method": "peek",
          "input": {},
          "expected": 1
        },
        {
          "type": "call",
          "method": "pop",
          "input": {},
          "expected": 1
        },
        {
          "type": "call",
          "method": "empty",
          "input": {},
          "expected": false
        },
        {
          "type": "call",
          "method": "pop",
          "input": {},
          "expected": 2
        },
        {
          "type": "call",
          "method": "empty",
          "input": {},
          "expected": true
        }
      ]
    },
    {
      "name": "interleaved pushes and pops",
      "operations": [
        {
          "type": "constructor",
          "input": {},
          "expected": null
        },
        {
          "type": "call",
          "method": "push",
          "input": {
            "x": 4
          },
          "expected": null
        },
        {
          "type": "call",
          "method": "push",
          "input": {
            "x": 5
          },
          "expected": null
        },
        {
          "type": "call",
          "method": "pop",
          "input": {},
          "expected": 4
        },
        {
          "type": "call",
          "method": "push",
          "input": {
            "x": 6
          },
          "expected": null
        },
        {
          "type": "call",
          "method": "peek",
          "input": {},
          "expected": 5
        },
        {
          "type": "call",
          "method": "pop",
          "input": {},
          "expected": 5
        },
        {
          "type": "call",
          "method": "pop",
          "input": {},
          "expected": 6
        },
        {
          "type": "call",
          "method": "empty",
          "input": {},
          "expected": true
        }
      ]
    }
  ]
}
