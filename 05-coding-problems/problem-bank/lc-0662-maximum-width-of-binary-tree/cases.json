{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "missing middle creates width",
      "input": {
        "root": [
          1,
          3,
          2,
          5,
          3,
          null,
          9
        ]
      },
      "expected": 4
    },
    {
      "name": "single node",
      "input": {
        "root": [
          1
        ]
      },
      "expected": 1
    },
    {
      "name": "full first level",
      "input": {
        "root": [
          1,
          2,
          3
        ]
      },
      "expected": 2
    },
    {
      "name": "left chain",
      "input": {
        "root": [
          1,
          2,
          null,
          3,
          null,
          4
        ]
      },
      "expected": 1
    },
    {
      "name": "outer grandchildren",
      "input": {
        "root": [
          1,
          2,
          3,
          4,
          null,
          null,
          5
        ]
      },
      "expected": 4
    },
    {
      "name": "deep sparse outer nodes",
      "input": {
        "root": [
          1,
          2,
          3,
          4,
          null,
          null,
          5,
          6,
          null,
          null,
          7
        ]
      },
      "expected": 8
    }
  ]
}
