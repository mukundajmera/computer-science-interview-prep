{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "balanced tree",
      "input": {
        "root": [
          4,
          2,
          6,
          1,
          3,
          5,
          7
        ]
      },
      "expected": [
        4,
        2,
        1,
        3,
        6,
        5,
        7
      ]
    },
    {
      "name": "left chain",
      "input": {
        "root": [
          3,
          2,
          null,
          1
        ]
      },
      "expected": [
        3,
        2,
        1
      ]
    },
    {
      "name": "empty tree",
      "input": {
        "root": []
      },
      "expected": []
    }
  ]
}
