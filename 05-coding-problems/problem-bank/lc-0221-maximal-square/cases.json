{
  "source": "repo-authored-clean-room",
  "matcher": { "type": "exact" },
  "cases": [
    {
      "name": "two by two all ones",
      "input": {
        "matrix": [
          ["1", "1"],
          ["1", "1"]
        ]
      },
      "expected": 4
    },
    {
      "name": "best square avoids first row",
      "input": {
        "matrix": [
          ["1", "0", "1"],
          ["1", "1", "1"],
          ["1", "1", "1"]
        ]
      },
      "expected": 4
    },
    {
      "name": "single zero",
      "input": { "matrix": [["0"]] },
      "expected": 0
    },
    {
      "name": "single row",
      "input": { "matrix": [["1", "1", "1", "1"]] },
      "expected": 1
    },
    {
      "name": "three by three all ones",
      "input": {
        "matrix": [
          ["1", "1", "1"],
          ["1", "1", "1"],
          ["1", "1", "1"]
        ]
      },
      "expected": 9
    }
  ]
}
