{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "mixed singles and ranges",
      "input": {
        "nums": [
          -3,
          -2,
          -1,
          2,
          4,
          5
        ]
      },
      "expected": [
        "-3->-1",
        "2",
        "4->5"
      ]
    },
    {
      "name": "all singles",
      "input": {
        "nums": [
          1,
          3,
          5
        ]
      },
      "expected": [
        "1",
        "3",
        "5"
      ]
    },
    {
      "name": "one long run",
      "input": {
        "nums": [
          6,
          7,
          8,
          9
        ]
      },
      "expected": [
        "6->9"
      ]
    },
    {
      "name": "empty",
      "input": {
        "nums": []
      },
      "expected": []
    }
  ]
}
