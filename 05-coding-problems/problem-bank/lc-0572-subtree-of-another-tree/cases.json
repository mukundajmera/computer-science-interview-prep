{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "subtree matches left branch",
      "input": {
        "root": [
          3,
          4,
          5,
          1,
          2
        ],
        "subRoot": [
          4,
          1,
          2
        ]
      },
      "expected": true
    },
    {
      "name": "extra descendant breaks match",
      "input": {
        "root": [
          3,
          4,
          5,
          1,
          2,
          null,
          null,
          null,
          null,
          0
        ],
        "subRoot": [
          4,
          1,
          2
        ]
      },
      "expected": false
    },
    {
      "name": "single node match",
      "input": {
        "root": [
          1,
          2,
          3
        ],
        "subRoot": [
          3
        ]
      },
      "expected": true
    },
    {
      "name": "same values different shape",
      "input": {
        "root": [
          1,
          1,
          null,
          1
        ],
        "subRoot": [
          1,
          null,
          1
        ]
      },
      "expected": false
    }
  ]
}
