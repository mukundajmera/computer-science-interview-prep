{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "two complete triples",
      "input": {
        "head": [
          1,
          2,
          3,
          4,
          5,
          6
        ],
        "k": 3
      },
      "expected": [
        3,
        2,
        1,
        6,
        5,
        4
      ],
      "linkedListContract": {
        "result": {
          "from": "head",
          "nodeIndices": [
            2,
            1,
            0,
            5,
            4,
            3
          ]
        }
      }
    },
    {
      "name": "tail remainder stays",
      "input": {
        "head": [
          9,
          8,
          7,
          6,
          5
        ],
        "k": 4
      },
      "expected": [
        6,
        7,
        8,
        9,
        5
      ],
      "linkedListContract": {
        "result": {
          "from": "head",
          "nodeIndices": [
            3,
            2,
            1,
            0,
            4
          ]
        }
      }
    },
    {
      "name": "unit group preserves list",
      "input": {
        "head": [
          4,
          5
        ],
        "k": 1
      },
      "expected": [
        4,
        5
      ],
      "linkedListContract": {
        "result": {
          "from": "head",
          "nodeIndices": [
            0,
            1
          ]
        }
      }
    }
  ]
}
