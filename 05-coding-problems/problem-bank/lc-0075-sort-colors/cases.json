{
  "source": "repo-authored-clean-room",
  "matcher": { "type": "exact" },
  "cases": [
    {
      "name": "mixed five values",
      "input": { "nums": [1, 0, 2, 1, 0] },
      "expected": null,
      "expectedMutations": { "nums": [0, 0, 1, 1, 2] }
    },
    {
      "name": "extra zeroes at end",
      "input": { "nums": [2, 1, 0, 2, 1, 0, 0] },
      "expected": null,
      "expectedMutations": { "nums": [0, 0, 0, 1, 1, 2, 2] }
    },
    {
      "name": "already sorted",
      "input": { "nums": [0, 0, 1, 1, 2] },
      "expected": null,
      "expectedMutations": { "nums": [0, 0, 1, 1, 2] }
    },
    {
      "name": "single color",
      "input": { "nums": [2, 2, 2] },
      "expected": null,
      "expectedMutations": { "nums": [2, 2, 2] }
    }
  ]
}
