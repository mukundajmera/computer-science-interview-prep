{
  "source": "repo-authored-clean-room",
  "matcher": { "type": "exact" },
  "cases": [
    {
      "name": "mixed length chains and empty slot",
      "input": { "lists": [[-4, 1, 9], null, [-3, 2], [0, 6, 7]] },
      "expected": [-4, -3, 0, 1, 2, 6, 7, 9]
    },
    {
      "name": "duplicates across lists",
      "input": { "lists": [[1, 1, 5], [1, 3, 3], [2, 2, 4]] },
      "expected": [1, 1, 1, 2, 2, 3, 3, 4, 5]
    },
    {
      "name": "no available nodes",
      "input": { "lists": [null, null] },
      "expected": null
    },
    {
      "name": "empty outer list",
      "input": { "lists": [] },
      "expected": null
    }
  ]
}
