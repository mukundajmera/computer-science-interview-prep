      "input": {
        "candidates": [
          2,
          6,
          8
        ],
        "target": 8
      },
      "expected": [
        [
          2,
          2,
          2,
          2
        ],
        [
          2,
          6
        ],
        [
          8
        ]
      ]
    },
    {
      "name": "no combination",
      "input": {
        "candidates": [
          7,
          10
        ],
        "target": 6
      },
      "expected": []
