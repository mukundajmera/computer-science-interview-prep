{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "square clockwise",
      "input": {
        "matrix": [
          [
            2,
            3,
            4
          ],
          [
            9,
            10,
            5
          ],
          [
            8,
            7,
            6
          ]
        ]
      },
      "expected": [
        2,
        3,
        4,
        5,
        6,
        7,
        8,
        9,
        10
      ]
    },
    {
      "name": "single row",
      "input": {
        "matrix": [
          [
            1,
            2,
            3,
            4
          ]
        ]
      },
      "expected": [
        1,
        2,
        3,
        4
      ]
    },
    {
      "name": "single column",
      "input": {
        "matrix": [
          [
            1
          ],
          [
            2
          ],
          [
            3
          ]
        ]
      },
      "expected": [
        1,
        2,
        3
      ]
    },
    {
      "name": "tall rectangle",
      "input": {
        "matrix": [
          [
            1,
            2
          ],
          [
            3,
            4
          ],
          [
            5,
            6
          ]
        ]
      },
      "expected": [
        1,
        2,
        4,
        6,
        5,
        3
      ]
    },
    {
      "name": "empty matrix",
      "input": {
        "matrix": []
      },
      "expected": []
    }
  ]
}
