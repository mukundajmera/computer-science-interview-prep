{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "unordered-tree-list"
  },
  "cases": [
    {
      "name": "zero values",
      "input": {
        "n": 0
      },
      "expected": []
    },
    {
      "name": "single tree",
      "input": {
        "n": 1
      },
      "expected": [
        [
          1
        ]
      ]
    },
    {
      "name": "five trees for three values",
      "input": {
        "n": 3
      },
      "expected": [
        [
          1,
          null,
          2,
          null,
          3
        ],
        [
          1,
          null,
          3,
          2
        ],
        [
          2,
          1,
          3
        ],
        [
          3,
          1,
          null,
          null,
          2
        ],
        [
          3,
          2,
          null,
          1
        ]
      ]
    }
  ]
}
