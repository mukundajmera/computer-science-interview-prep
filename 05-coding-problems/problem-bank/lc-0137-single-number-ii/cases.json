{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "negative singleton",
      "input": {
        "nums": [
          5,
          5,
          -4,
          5
        ]
      },
      "expected": -4
    },
    {
      "name": "middle singleton",
      "input": {
        "nums": [
          8,
          1,
          8,
          8
        ]
      },
      "expected": 1
    },
    {
      "name": "zero repeated",
      "input": {
        "nums": [
          0,
          0,
          0,
          12
        ]
      },
      "expected": 12
    },
    {
      "name": "minimum integer singleton",
      "input": {
        "nums": [
          4,
          4,
          -2147483648,
          4
        ]
      },
      "expected": -2147483648
    }
  ]
}
