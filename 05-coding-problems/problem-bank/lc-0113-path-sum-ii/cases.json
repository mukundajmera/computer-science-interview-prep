{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "unordered-list-of-lists"
  },
  "cases": [
    {
      "name": "two matching leaves",
      "input": {
        "root": [
          5,
          4,
          8,
          11,
          null,
          13,
          4,
          7,
          2,
          null,
          null,
          5,
          1
        ],
        "targetSum": 22
      },
      "expected": [
        [
          5,
          4,
          11,
          2
        ],
        [
          5,
          8,
          4,
          5
        ]
      ]
    },
    {
      "name": "no matching leaf",
      "input": {
        "root": [
          1,
          2,
          3
        ],
        "targetSum": 5
      },
      "expected": []
    },
    {
      "name": "single matching root",
      "input": {
        "root": [
          1
        ],
        "targetSum": 1
      },
      "expected": [
        [
          1
        ]
      ]
    },
    {
      "name": "negative values",
      "input": {
        "root": [
          1,
          -2,
          -3,
          1,
          3,
          -2,
          null,
          -1
        ],
        "targetSum": -1
      },
      "expected": [
        [
          1,
          -2,
          1,
          -1
        ]
      ]
    },
    {
      "name": "target at internal node does not count",
      "input": {
        "root": [
          1,
          2
        ],
        "targetSum": 1
      },
      "expected": []
    }
  ]
}
