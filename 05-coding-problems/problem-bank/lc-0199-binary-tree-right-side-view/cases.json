{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "balanced tree",
      "input": {
        "root": [
          8,
          4,
          12,
          2,
          6,
          10,
          14
        ]
      },
      "expected": [
        8,
        12,
        14
      ]
    },
    {
      "name": "right branch with inner child",
      "input": {
        "root": [
          5,
          null,
          9,
          8
        ]
      },
      "expected": [
        5,
        9,
        8
      ]
    },
    {
      "name": "empty tree",
      "input": {
        "root": []
      },
      "expected": []
    }
  ]
}
