          "topRight": { "val": false, "isLeaf": true, "topLeft": null, "topRight": null, "bottomLeft": null, "bottomRight": null },
          "bottomLeft": { "val": false, "isLeaf": true, "topLeft": null, "topRight": null, "bottomLeft": null, "bottomRight": null },
          "bottomRight": { "val": false, "isLeaf": true, "topLeft": null, "topRight": null, "bottomLeft": null, "bottomRight": null }
        },
        "bottomRight": { "val": false, "isLeaf": true, "topLeft": null, "topRight": null, "bottomLeft": null, "bottomRight": null }
