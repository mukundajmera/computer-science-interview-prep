{
  "source": "repo-authored-clean-room",
  "matcher": { "type": "exact" },
  "cases": [
    {
      "name": "zeroes between positives",
      "input": { "nums": [4, 0, 5, 0, 6] },
      "expected": null,
      "expectedMutations": { "nums": [4, 5, 6, 0, 0] }
    },
    {
      "name": "leading zero block",
      "input": { "nums": [0, 0, 2, 3] },
      "expected": null,
      "expectedMutations": { "nums": [2, 3, 0, 0] }
    },
    {
      "name": "already without zeroes",
      "input": { "nums": [7, 8, 9] },
      "expected": null,
      "expectedMutations": { "nums": [7, 8, 9] }
    },
    {
      "name": "clustered zeroes",
      "input": { "nums": [0, 4, 0, 0, 5, 6] },
      "expected": null,
      "expectedMutations": { "nums": [4, 5, 6, 0, 0, 0] }
    }
  ]
}
