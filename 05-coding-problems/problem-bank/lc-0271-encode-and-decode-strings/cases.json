{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "ordinary words",
      "operations": [
        {
          "type": "constructor",
          "input": {},
          "expected": null
        },
        {
          "type": "call",
          "method": "encode",
          "input": {
            "strs": [
              "lint",
              "code",
              "love",
              "you"
            ]
          },
          "expected": "4#lint4#code4#love3#you"
        },
        {
          "type": "call",
          "method": "decode",
          "input": {
            "s": "4#lint4#code4#love3#you"
          },
          "expected": [
            "lint",
            "code",
            "love",
            "you"
          ]
        }
      ]
    },
    {
      "name": "empty and delimiter characters",
      "operations": [
        {
          "type": "constructor",
          "input": {},
          "expected": null
        },
        {
          "type": "call",
          "method": "encode",
          "input": {
            "strs": [
              "",
              "#",
              "a#b",
              "00"
            ]
          },
          "expected": "0#1##3#a#b2#00"
        },
        {
          "type": "call",
          "method": "decode",
          "input": {
            "s": "0#1##3#a#b2#00"
          },
          "expected": [
            "",
            "#",
            "a#b",
            "00"
          ]
        }
      ]
    }
  ]
}
