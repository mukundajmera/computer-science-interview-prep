{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "best spans middle bars",
      "input": {
        "heights": [
          2,
          1,
          5,
          6,
          2,
          3
        ]
      },
      "expected": 10
    },
    {
      "name": "increasing bars",
      "input": {
        "heights": [
          1,
          2,
          3,
          4
        ]
      },
      "expected": 6
    },
    {
      "name": "all equal bars",
      "input": {
        "heights": [
          4,
          4,
          4
        ]
      },
      "expected": 12
    },
    {
      "name": "single bar",
      "input": {
        "heights": [
          7
        ]
      },
      "expected": 7
    },
    {
      "name": "strictly decreasing bars",
      "input": {
        "heights": [
          4,
          3,
          2,
          1
        ]
      },
      "expected": 6
    },
    {
      "name": "zero splits bars",
      "input": {
        "heights": [
          2,
          0,
          2
        ]
      },
      "expected": 2
    },
    {
      "name": "low valley spans three bars",
      "input": {
        "heights": [
          2,
          1,
          2
        ]
      },
      "expected": 3
    }
  ]
}
