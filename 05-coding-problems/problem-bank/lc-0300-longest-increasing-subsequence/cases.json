{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "drops before rising tail",
      "input": {
        "nums": [
          4,
          10,
          4,
          3,
          8,
          9
        ]
      },
      "expected": 3
    },
    {
      "name": "strictly decreasing",
      "input": {
        "nums": [
          5,
          4,
          3,
          2
        ]
      },
      "expected": 1
    },
    {
      "name": "long mixed sequence",
      "input": {
        "nums": [
          1,
          3,
          6,
          7,
          9,
          4,
          10,
          5,
          6
        ]
      },
      "expected": 6
    }
  ]
}
