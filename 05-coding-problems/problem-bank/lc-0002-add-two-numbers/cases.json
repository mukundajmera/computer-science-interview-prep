{
  "source": "repo-authored-clean-room",
  "matcher": { "type": "exact" },
  "cases": [
    {
      "name": "different length with carry",
      "input": { "l1": [4, 2, 7], "l2": [6, 8] },
      "expected": [0, 1, 8]
    },
    {
      "name": "carry creates new digit",
      "input": { "l1": [9, 9], "l2": [1] },
      "expected": [0, 0, 1]
    },
    {
      "name": "left zero",
      "input": { "l1": [0], "l2": [5, 4] },
      "expected": [5, 4]
    }
  ]
}
