{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "target in the middle",
      "input": {
        "nums": [
          1,
          3,
          5,
          7
        ],
        "target": 5
      },
      "expected": 2
    },
    {
      "name": "target below range",
      "input": {
        "nums": [
          2,
          4,
          6
        ],
        "target": 1
      },
      "expected": -1
    },
    {
      "name": "single element hit",
      "input": {
        "nums": [
          9
        ],
        "target": 9
      },
      "expected": 0
    },
    {
      "name": "single element miss",
      "input": {
        "nums": [
          9
        ],
        "target": 4
      },
      "expected": -1
    },
    {
      "name": "negative values",
      "input": {
        "nums": [
          -10,
          -3,
          0,
          4,
          9
        ],
        "target": -3
      },
      "expected": 1
    }
  ]
}
