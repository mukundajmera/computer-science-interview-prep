{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "overlapping middle range",
      "input": {
        "nums": [
          [
            4,
            10,
            15
          ],
          [
            1,
            8,
            20
          ],
          [
            7,
            12
          ]
        ]
      },
      "expected": [
        7,
        10
      ]
    },
    {
      "name": "duplicate zero width range",
      "input": {
        "nums": [
          [
            1,
            2,
            3
          ],
          [
            1,
            2,
            3
          ]
        ]
      },
      "expected": [
        1,
        1
      ]
    },
    {
      "name": "negative values",
      "input": {
        "nums": [
          [
            -5,
            -4,
            20
          ],
          [
            0,
            3
          ],
          [
            2,
            4
          ]
        ]
      },
      "expected": [
        -4,
        2
      ]
    },
    {
      "name": "all singleton lists",
      "input": {
        "nums": [
          [
            5
          ],
          [
            1
          ],
          [
            3
          ]
        ]
      },
      "expected": [
        1,
        5
      ]
    }
  ]
}
