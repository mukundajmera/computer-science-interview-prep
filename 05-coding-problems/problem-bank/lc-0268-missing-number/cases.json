{
  "source": "repo-authored-clean-room",
  "matcher": {
    "type": "exact"
  },
  "cases": [
    {
      "name": "middle value missing",
      "input": {
        "nums": [
          4,
          2,
          0,
          1
        ]
      },
      "expected": 3
    },
    {
      "name": "one value missing from pair",
      "input": {
        "nums": [
          2,
          0
        ]
      },
      "expected": 1
    },
    {
      "name": "largest value missing",
      "input": {
        "nums": [
          0,
          1,
          2,
          3
        ]
      },
      "expected": 4
    },
    {
      "name": "zero missing",
      "input": {
        "nums": [
          1
        ]
      },
      "expected": 0
    },
    {
      "name": "one missing",
      "input": {
        "nums": [
          0
        ]
      },
      "expected": 1
    },
    {
      "name": "zero missing from larger range",
      "input": {
        "nums": [
          1,
          2,
          3,
          4
        ]
      },
      "expected": 0
    }
  ]
}
